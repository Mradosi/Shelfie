---
import SkinProfileWizard from "@/components/onboarding/SkinProfileWizard";
import Layout from "@/layouts/Layout.astro";
import {
  createEmptyUserProfile,
  getMissingUserDomainContractMessage,
  getUserProfile,
  isMissingUserDomainContractError,
  isUserProfileComplete,
} from "@/lib/domain/user-domain";
import { createClient } from "@/lib/supabase";

const user = Astro.locals.user;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const mode = Astro.url.searchParams.get("mode");

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;
let persistedProfile = null;

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    persistedProfile = await getUserProfile(supabase, user.id);

    if (isUserProfileComplete(persistedProfile) && mode !== "rerun") {
      return Astro.redirect("/settings/skin-profile");
    }
  } catch (loadError) {
    routeError = isMissingUserDomainContractError(loadError)
      ? getMissingUserDomainContractMessage()
      : loadError instanceof Error
        ? loadError.message
        : "Nie udało się wczytać bieżącego stanu profilu.";
  }
}

const profile = persistedProfile ?? createEmptyUserProfile();
---

<Layout title="Onboarding profilu skóry">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-5xl items-center justify-center py-10">
      <section class="w-full rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
        <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">Pierwszy profil skóry</p>
        <h1 class="mt-3 text-3xl font-bold text-white">Zacznijmy od Twojego bazowego profilu skóry.</h1>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-blue-100/75">
          Ten onboarding prowadzi Cię przez lekki zestaw pytań, zapisuje profil w obecnym kontrakcie i zostawia
          dodawanie produktów na kolejny etap.
        </p>

        {
          mode === "rerun" && (
            <p class="mt-6 rounded-2xl border border-cyan-300/30 bg-cyan-950/30 px-4 py-3 text-sm text-cyan-100">
              Przechodzisz teraz ponownie przez pytania onboardingowe, żeby odświeżyć bazowy profil skóry.
            </p>
          )
        }

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        {
          success && (
            <p class="mt-6 rounded-2xl border border-emerald-400/30 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-200">
              {success}
            </p>
          )
        }

        {
          !routeError && (
            <SkinProfileWizard
              client:load
              serverError={error}
              initialSkinType={profile.skinType}
              initialConcerns={profile.concerns}
              initialGoals={profile.goals}
            />
          )
        }
      </section>
    </div>
  </div>
</Layout>
