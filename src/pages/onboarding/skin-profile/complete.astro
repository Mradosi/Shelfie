---
import Layout from "@/layouts/Layout.astro";
import { consumeFlashMessage } from "@/lib/flash-message";
import { createClient } from "@/lib/supabase";
import {
  getMissingUserDomainContractMessage,
  getUserProfile,
  isMissingUserDomainContractError,
  isUserProfileComplete,
} from "@/lib/domain/user-domain";

const user = Astro.locals.user;
const flash = consumeFlashMessage(Astro.cookies);

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    const profile = await getUserProfile(supabase, user.id);

    if (!isUserProfileComplete(profile)) {
      return Astro.redirect("/onboarding/skin-profile");
    }

  } catch (error) {
    routeError = isMissingUserDomainContractError(error)
      ? getMissingUserDomainContractMessage()
      : error instanceof Error
        ? error.message
        : "Nie udało się sprawdzić stanu profilu.";
  }
}
---

<Layout title="Profil zapisany">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-4xl items-center justify-center py-10">
      <section class="w-full rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
        <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">Onboarding zakończony</p>
        <h1 class="mt-3 text-3xl font-bold text-white">Twój profil skóry jest już zapisany.</h1>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-blue-100/75">
          Świetnie. Mamy już punkt wyjścia do dalszej personalizacji, a kolejnym krokiem będzie dodanie pierwszego
          produktu.
        </p>

        {
          flash && (
            <p
              class:list={[
                "mt-6 rounded-2xl px-4 py-3 text-sm",
                flash.kind === "success"
                  ? "border border-emerald-400/30 bg-emerald-950/40 text-emerald-200"
                  : "border border-red-400/30 bg-red-950/40 text-red-200",
              ]}
            >
              {flash.message}
            </p>
          )
        }

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
            <p class="text-sm font-semibold text-white">Profil gotowy</p>
            <p class="mt-3 text-sm leading-6 text-blue-100/70">
              Podstawowy kontekst skóry został zapisany i jest gotowy do dalszego wykorzystania.
            </p>
          </div>
          <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
            <p class="text-sm font-semibold text-white">Półka nadal jest pusta</p>
            <p class="mt-3 text-sm leading-6 text-blue-100/70">
              Na tym etapie nie dodajemy jeszcze produktów. To będzie kolejny slice produktu.
            </p>
          </div>
          <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
            <p class="text-sm font-semibold text-white">Możesz wrócić później</p>
            <p class="mt-3 text-sm leading-6 text-blue-100/70">
              W każdej chwili wejdziesz do ustawień profilu i poprawisz zapisane informacje.
            </p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/settings/skin-profile"
            class="rounded-full bg-cyan-300 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-transform hover:-translate-y-0.5"
          >
            Przejdź do profilu
          </a>
          <a
            href="/dashboard"
            class="rounded-full border border-white/20 bg-white/8 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/16"
          >
            Otwórz panel debugowy
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
