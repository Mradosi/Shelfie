---
import ProductInterpretationPanel from "@/components/products/ProductInterpretationPanel";
import IngredientGlossaryPanel from "@/components/products/IngredientGlossaryPanel";
import RemoveShelfItemForm from "@/components/products/RemoveShelfItemForm.astro";
import Layout from "@/layouts/Layout.astro";
import { consumeFlashMessage } from "@/lib/flash-message";
import {
  createIngredientGlossaryItems,
  createIngredientGlossaryRequests,
  listIngredientGlossaryEntries,
  type IngredientGlossaryItem,
} from "@/lib/domain/ingredient-glossary";
import { getUserScopedProductDetails } from "@/lib/domain/product-interpretation";
import {
  INGREDIENT_GLOSSARY_MODEL_VERSION,
  INGREDIENT_GLOSSARY_PROMPT_VERSION,
} from "@/lib/integrations/openrouter-ingredient-glossary";
import { createClient } from "@/lib/supabase";
import {
  getMissingUserDomainContractMessage,
  getUserProfile,
  isMissingUserDomainContractError,
  isUserProfileComplete,
  listUserShelfItems,
} from "@/lib/domain/user-domain";

const user = Astro.locals.user;
const productId = Astro.params.productId;
const flash = consumeFlashMessage(Astro.cookies);

if (!user) {
  return Astro.redirect("/auth/signin");
}

if (!productId) {
  return Astro.redirect("/products/intake");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;
let details: Awaited<ReturnType<typeof getUserScopedProductDetails>> | null = null;
let isOnShelf = false;
let shelfItemId: string | null = null;
let ingredientGlossaryItems: IngredientGlossaryItem[] = [];
let ingredientGlossaryError: string | null = null;

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    const profile = await getUserProfile(supabase, user.id);
    if (!isUserProfileComplete(profile)) {
      return Astro.redirect("/onboarding/skin-profile");
    }

    const [loadedDetails, shelfItems] = await Promise.all([
      getUserScopedProductDetails(supabase, user.id, productId),
      listUserShelfItems(supabase, user.id),
    ]);
    details = loadedDetails;
    const shelfItem = shelfItems.find((item) => item.productId === loadedDetails.product.id);
    isOnShelf = Boolean(shelfItem);
    shelfItemId = shelfItem?.id ?? null;

    try {
      const requests = createIngredientGlossaryRequests(loadedDetails.product.inciList);
      const entries = await listIngredientGlossaryEntries(supabase, requests, {
        modelVersion: INGREDIENT_GLOSSARY_MODEL_VERSION,
        promptVersion: INGREDIENT_GLOSSARY_PROMPT_VERSION,
      });
      ingredientGlossaryItems = createIngredientGlossaryItems(loadedDetails.product.inciList, entries);
    } catch (error) {
      ingredientGlossaryError = error instanceof Error ? error.message : "Nie udało się wczytać opisów składników.";
      ingredientGlossaryItems = createIngredientGlossaryItems(loadedDetails.product.inciList, []);
    }
  } catch (error) {
    routeError = isMissingUserDomainContractError(error)
      ? getMissingUserDomainContractMessage()
      : error instanceof Error
        ? error.message
        : "Nie udało się wczytać szczegółów produktu.";
  }
}

const product = details?.product;
const categoryLabel = product?.category ?? "Nieustalona kategoria";
const provenance = [product?.inciSource, product?.inciConfidence ? `pewność: ${product.inciConfidence}` : null]
  .filter(Boolean)
  .join(" · ");
---

<Layout title={product ? `${product.name} | Shelfie` : "Szczegóły produktu | Shelfie"} showAppNavigation>
  <div class="text-white">
    <main class="mx-auto w-full max-w-6xl py-6 sm:py-10">
      <a
        href="/products/intake"
        class="inline-flex rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-blue-100/85 transition-colors hover:bg-white/12"
      >
        Wróć do wyszukiwania produktów
      </a>

      {
        routeError && (
          <section class="mt-6 rounded-[1.75rem] border border-amber-400/30 bg-amber-950/35 p-6">
            <p class="text-sm tracking-[0.2em] text-amber-100/65 uppercase">Szczegóły produktu</p>
            <h1 class="mt-2 text-2xl font-semibold text-white">Nie udało się otworzyć produktu</h1>
            <p class="mt-3 text-sm leading-6 text-amber-100">{routeError}</p>
          </section>
        )
      }

      {
        details && product && (
          <div class="mt-6 space-y-6">
            {flash && (
              <p
                class:list={[
                  "rounded-2xl px-4 py-3 text-sm",
                  flash.kind === "success"
                    ? "border border-emerald-300/25 bg-emerald-300/10 text-emerald-50"
                    : "border border-rose-300/25 bg-rose-950/40 text-rose-100",
                ]}
              >
                {flash.message}
              </p>
            )}
            <section class="overflow-hidden rounded-[2rem] border border-white/12 bg-white/8 shadow-2xl shadow-slate-950/25 backdrop-blur-xl">
              <div class="grid gap-0 lg:grid-cols-[minmax(16rem,0.7fr)_minmax(0,1.3fr)]">
                <div class="flex min-h-72 items-center justify-center bg-linear-to-br from-cyan-300/16 via-slate-950/20 to-blue-500/12 p-8">
                  {product.imageUrl ? (
                    <img
                      src={product.imageUrl}
                      alt={product.name}
                      class="max-h-80 max-w-full rounded-[1.5rem] object-contain shadow-2xl shadow-slate-950/30"
                    />
                  ) : (
                    <div class="flex size-40 items-center justify-center rounded-[2rem] border border-dashed border-white/20 bg-slate-950/20 text-center text-sm leading-6 text-blue-100/65">
                      Brak zdjęcia produktu
                    </div>
                  )}
                </div>

                <div class="p-6 sm:p-8">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <span class="rounded-full border border-cyan-200/25 bg-cyan-200/10 px-3 py-1.5 text-sm font-medium text-cyan-100">
                      {isOnShelf ? "Na Twojej półce" : "Poza Twoją półką"}
                    </span>
                    <span class="rounded-full border border-white/12 bg-white/5 px-3 py-1.5 text-sm text-blue-100/75">
                      {categoryLabel}
                    </span>
                  </div>
                  <p class="mt-7 text-sm tracking-[0.22em] text-cyan-100/55 uppercase">Produkt</p>
                  <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">{product.name}</h1>
                  {product.brand && <p class="mt-3 text-lg text-cyan-100/85">{product.brand}</p>}
                  <p class="mt-6 max-w-2xl text-sm leading-6 text-blue-100/70">
                    Dane produktu pochodzą ze wspólnej bazy. Twoja analiza poniżej jest osobna i widoczna tylko dla
                    Ciebie.
                  </p>
                  {isOnShelf && (
                    <a
                      href="/shelf"
                      class="mt-5 inline-flex rounded-full border border-white/18 bg-white/6 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/14"
                    >
                      Wróć do mojej półki
                    </a>
                  )}
                  {!isOnShelf && (
                    <form method="POST" action="/api/domain/products/add-existing" class="mt-5">
                      <input type="hidden" name="productId" value={product.id} />
                      <input type="hidden" name="successRedirectTo" value={`/products/${product.id}`} />
                      <input type="hidden" name="errorRedirectTo" value={`/products/${product.id}`} />
                      <button
                        type="submit"
                        class="rounded-full bg-cyan-300 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-transform hover:-translate-y-0.5"
                      >
                        Dodaj do mojej półki
                      </button>
                    </form>
                  )}
                  {shelfItemId && (
                    <RemoveShelfItemForm
                      shelfItemId={shelfItemId}
                      successRedirectTo={`/products/${product.id}`}
                      errorRedirectTo={`/products/${product.id}`}
                      label="Usuń z mojej półki"
                      className="mt-5"
                    />
                  )}
                  <dl class="mt-7 grid gap-4 text-sm sm:grid-cols-2">
                    <div class="rounded-2xl border border-white/10 bg-slate-950/25 p-4">
                      <dt class="text-blue-100/50">Pochodzenie danych INCI</dt>
                      <dd class="mt-1 font-medium text-white">{provenance || "Brak informacji"}</dd>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-slate-950/25 p-4">
                      <dt class="text-blue-100/50">Ostatnia aktualizacja INCI</dt>
                      <dd class="mt-1 font-medium text-white">{product.inciUpdatedAt ?? "Brak informacji"}</dd>
                    </div>
                  </dl>
                </div>
              </div>
            </section>

            <ProductInterpretationPanel client:load initialInterpretation={details.interpretation} />

            <IngredientGlossaryPanel
              client:load
              productId={product.id}
              initialItems={ingredientGlossaryItems}
              initialError={ingredientGlossaryError}
            />
          </div>
        )
      }
    </main>
  </div>
</Layout>
