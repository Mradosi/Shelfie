---
import ProductIntakeFlow from "@/components/products/ProductIntakeFlow";
import Layout from "@/layouts/Layout.astro";
import { consumeFlashMessage } from "@/lib/flash-message";
import { createClient } from "@/lib/supabase";
import {
  getMissingUserDomainContractMessage,
  getUserProfile,
  isMissingUserDomainContractError,
  isUserProfileComplete,
} from "@/lib/domain/user-domain";

const user = Astro.locals.user;
const flash = consumeFlashMessage(Astro.cookies);
const error = flash?.kind === "error" ? flash.message : null;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    const profile = await getUserProfile(supabase, user.id);
    if (!isUserProfileComplete(profile)) {
      return Astro.redirect("/onboarding/skin-profile");
    }
  } catch (loadError) {
    routeError = isMissingUserDomainContractError(loadError)
      ? getMissingUserDomainContractMessage()
      : loadError instanceof Error
        ? loadError.message
        : "Nie udało się przygotować flow dodawania produktu.";
  }
}
---

<Layout title="Dodaj pierwszy produkt" showAppNavigation>
  <div class="text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center py-10">
      <section class="w-full rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
        <div class="flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">First product intake</p>
            <h1 class="mt-2 text-3xl font-bold text-white">Dodaj pierwszy produkt do swojej półki</h1>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-blue-100/75">
              Zaczynamy od wspólnej bazy i Open Beauty Facts. Jeśli dane będą niepełne, przeprowadzimy Cię przez
              fallback i obowiązkowe potwierdzenie przed zapisem.
            </p>
          </div>
        </div>

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        {!routeError && <ProductIntakeFlow client:load serverError={error} />}
      </section>
    </div>
  </div>
</Layout>
