---
import SkinProfileEditForm from "@/components/profile/SkinProfileEditForm";
import Layout from "@/layouts/Layout.astro";
import { consumeFlashMessage } from "@/lib/flash-message";
import { createClient } from "@/lib/supabase";
import {
  createEmptyUserProfile,
  getMissingUserDomainContractMessage,
  getUserProfile,
  isMissingUserDomainContractError,
  isUserProfileComplete,
} from "@/lib/domain/user-domain";

const user = Astro.locals.user;
const flash = consumeFlashMessage(Astro.cookies);
const error = flash?.kind === "error" ? flash.message : null;
const success = flash?.kind === "success" ? flash.message : null;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;
let persistedProfile = null;

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    persistedProfile = await getUserProfile(supabase, user.id);

    if (!isUserProfileComplete(persistedProfile)) {
      return Astro.redirect("/onboarding/skin-profile");
    }
  } catch (loadError) {
    routeError = isMissingUserDomainContractError(loadError)
      ? getMissingUserDomainContractMessage()
      : loadError instanceof Error
        ? loadError.message
        : "Nie udało się wczytać zapisanego profilu.";
  }
}

const profile = persistedProfile ?? createEmptyUserProfile();
---

<Layout title="Ustawienia profilu skóry" showAppNavigation>
  <div class="text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-5xl items-center justify-center py-10">
      <section class="w-full rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
        <div class="flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">Profil skóry</p>
            <h1 class="mt-2 text-3xl font-bold text-white">Edytuj zapisany profil</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/75">
              Tutaj możesz zmienić zapisane poziomy obszarów skóry, problemy, cele i dodatkowe notatki bez wracania do
              onboardingowego quizu.
            </p>
          </div>
          <a
            href="/dashboard"
            class="rounded-full border border-white/20 bg-white/8 px-4 py-2 text-sm text-white transition-colors hover:bg-white/16"
          >
            Otwórz panel
          </a>
        </div>

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        {
          success && (
            <p class="mt-6 rounded-2xl border border-emerald-400/30 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-200">
              {success}
            </p>
          )
        }

        {
          !routeError && isUserProfileComplete(persistedProfile) && (
            <SkinProfileEditForm
              client:load
              serverError={error}
              initialSkinType={profile.skinType}
              initialSkinAspects={profile.skinAspects}
              initialConcerns={profile.concerns}
              initialGoals={profile.goals}
              initialNotes={profile.notes}
            />
          )
        }
      </section>
    </div>
  </div>
</Layout>
