---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listSharedProducts, type SharedProduct } from "@/lib/domain/product-domain";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;
let sharedProducts: SharedProduct[] = [];

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    sharedProducts = await listSharedProducts(supabase);
  } catch (loadError) {
    routeError = loadError instanceof Error ? loadError.message : "Nie udało się wczytać listy produktów.";
  }
}
---

<Layout title="Debug produktów">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto w-full max-w-7xl py-10">
      <section class="rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
        <div class="flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">Debug surface</p>
            <h1 class="mt-2 text-3xl font-bold text-white">Współdzielone produkty</h1>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-blue-100/75">
              Tymczasowy ekran do sprawdzenia, czy produkty zapisują się poprawnie. Pokazuje wszystkie pola z
              `products`, a zdjęcia renderuje jako podgląd.
            </p>
          </div>
          <div class="rounded-full border border-white/12 bg-black/20 px-4 py-2 text-sm text-cyan-100">
            {sharedProducts.length} produkt{sharedProducts.length === 1 ? "" : sharedProducts.length < 5 ? "y" : "ów"}
          </div>
        </div>

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        {
          !routeError && (
            <div class="mt-8 space-y-6">
              {sharedProducts.length === 0 ? (
                <p class="rounded-2xl border border-white/12 bg-slate-950/30 px-4 py-4 text-sm text-blue-100/70">
                  Brak zapisanych produktów.
                </p>
              ) : (
                sharedProducts.map((product) => (
                  <article class="rounded-[1.75rem] border border-white/12 bg-slate-950/30 p-6">
                    <div class="grid gap-6 lg:grid-cols-[20rem_minmax(0,1fr)]">
                      <div class="space-y-4">
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                          <p class="text-xs tracking-[0.18em] text-blue-100/45 uppercase">Podgląd zdjęcia</p>
                          {product.imageUrl ? (
                            <img
                              src={product.imageUrl}
                              alt={`Podgląd produktu ${product.name}`}
                              class="mt-3 max-h-80 w-full rounded-2xl border border-white/10 object-contain"
                            />
                          ) : (
                            <p class="mt-3 text-sm text-blue-100/60">Brak zdjęcia produktu.</p>
                          )}
                        </div>

                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
                          <p>
                            <span class="text-blue-100/45">imageUrl (computed):</span> {product.imageUrl ?? "brak"}
                          </p>
                          <p class="mt-2">
                            <span class="text-blue-100/45">sourceImageUrl:</span> {product.sourceImageUrl ?? "brak"}
                          </p>
                          <p class="mt-2">
                            <span class="text-blue-100/45">storedImageUrl:</span> {product.storedImageUrl ?? "brak"}
                          </p>
                        </div>
                      </div>

                      <div class="space-y-4">
                        <div>
                          <p class="text-xs tracking-[0.18em] text-cyan-100/55 uppercase">Produkt</p>
                          <h2 class="mt-2 text-2xl font-semibold text-white">{product.name}</h2>
                          <p class="mt-2 text-sm text-blue-100/70">
                            {[product.brand, product.category].filter(Boolean).join(" · ") ||
                              "Brak dodatkowych metadanych"}
                          </p>
                        </div>

                        <div class="grid gap-4 md:grid-cols-2">
                          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
                            <p>
                              <span class="text-blue-100/45">id:</span> {product.id}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">brand:</span> {product.brand ?? "brak"}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">category:</span> {product.category ?? "brak"}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">barcode:</span> {product.barcode ?? "brak"}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">normalizedName:</span> {product.normalizedName}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">normalizedBrand:</span> {product.normalizedBrand}
                            </p>
                          </div>

                          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
                            <p>
                              <span class="text-blue-100/45">inciSource:</span> {product.inciSource ?? "brak"}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">inciConfidence:</span> {product.inciConfidence ?? "brak"}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">inciUpdatedAt:</span> {product.inciUpdatedAt ?? "brak"}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">createdAt:</span> {product.createdAt}
                            </p>
                            <p class="mt-2">
                              <span class="text-blue-100/45">updatedAt:</span> {product.updatedAt}
                            </p>
                          </div>
                        </div>

                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                          <p class="text-xs tracking-[0.18em] text-blue-100/45 uppercase">INCI</p>
                          <div class="mt-3 flex flex-wrap gap-2 text-sm text-white/90">
                            {product.inciList.length > 0 ? (
                              product.inciList.map((ingredient) => (
                                <span class="rounded-full border border-white/10 bg-slate-950/40 px-3 py-1">
                                  {ingredient}
                                </span>
                              ))
                            ) : (
                              <span class="text-blue-100/60">Brak listy INCI.</span>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  </article>
                ))
              )}
            </div>
          )
        }
      </section>
    </div>
  </div>
</Layout>
