---
import Welcome from "@/components/Welcome.astro";
import { getRootRedirectPath } from "@/lib/domain/app-navigation";
import Layout from "@/layouts/Layout.astro";

const rootRedirectPath = getRootRedirectPath(Boolean(Astro.locals.user));

if (rootRedirectPath) {
  return Astro.redirect(rootRedirectPath);
}
---

<Layout>
  <Welcome />
</Layout>
