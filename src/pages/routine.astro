---
import ManualRoutineEditor from "@/components/routine/ManualRoutineEditor";
import Layout from "@/layouts/Layout.astro";
import {
  collapseWeeklyScheduleToBaseRoutine,
  createEmptyBaseRoutine,
  hasNonEmptyBaseRoutine,
} from "@/lib/domain/routine-schedule";
import { createClient } from "@/lib/supabase";
import {
  getMissingUserDomainContractMessage,
  getUserProfile,
  getUserRoutineConfig,
  isMissingUserDomainContractError,
  isUserProfileComplete,
  listUserShelfCatalog,
} from "@/lib/domain/user-domain";

const user = Astro.locals.user;
const error = Astro.url.searchParams.get("error");
const routineFlow = Astro.url.searchParams.get("routineFlow");
const success = Astro.url.searchParams.get("success");

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;
let initialDraft = createEmptyBaseRoutine();
let shelfCatalog = [];

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    const profile = await getUserProfile(supabase, user.id);
    if (!isUserProfileComplete(profile)) {
      return Astro.redirect("/onboarding/skin-profile");
    }

    const [ownedShelfCatalog, routineConfig] = await Promise.all([
      listUserShelfCatalog(supabase, user.id),
      getUserRoutineConfig(supabase, user.id),
    ]);

    shelfCatalog = ownedShelfCatalog;

    if (routineConfig) {
      initialDraft = collapseWeeklyScheduleToBaseRoutine(routineConfig.schedule);
    }
  } catch (loadError) {
    routeError = isMissingUserDomainContractError(loadError)
      ? getMissingUserDomainContractMessage()
      : loadError instanceof Error
        ? loadError.message
        : "Nie udało się przygotować edytora rutyny.";
  }
}

const shelfCount = shelfCatalog.length;
const hasVeryFewProducts = shelfCount > 0 && shelfCount < 2;
const hasPersistedRoutine = hasNonEmptyBaseRoutine(initialDraft);

type RoutinePageState = "needs_products" | "empty" | "saved" | "reset";

const pageState: RoutinePageState =
  shelfCount === 0 ? "needs_products" : routineFlow === "reset" ? "reset" : hasPersistedRoutine ? "saved" : "empty";

const pageStateCopy: Record<
  RoutinePageState,
  {
    badge: string;
    heading: string;
    intro: string;
    panelTitle: string;
    panelBody: string;
  }
> = {
  needs_products: {
    badge: "Najpierw dodaj produkty do półki",
    heading: "Przygotuj produkty do swojej pierwszej rutyny",
    intro:
      "Ten widok pozostaje dostępny, ale do zbudowania bazowej rutyny AM/PM potrzebujesz najpierw choć jednego produktu na półce.",
    panelTitle: "Brakuje produktów do rozpoczęcia",
    panelBody:
      "Gdy dodasz pierwszy produkt, wróć tutaj i przypisz go do sekcji porannej albo wieczornej. Sama rutyna pozostaje na razie pusta.",
  },
  empty: {
    badge: "Gotowe do ułożenia pierwszej rutyny",
    heading: "Ułóż swoją pierwszą bazową rutynę AM/PM",
    intro:
      "Zacznij od dodania pierwszych kroków do sekcji porannej i wieczornej. Każdy wpis dostaje własną rolę, a zapis trafia do wspólnego weekly schedule.",
    panelTitle: "Nie masz jeszcze zapisanej rutyny",
    panelBody:
      "Dodaj pierwszy krok do porannej albo wieczornej sekcji, ustaw kolejność i zapisz całość dopiero wtedy, gdy baza będzie gotowa.",
  },
  saved: {
    badge: routineFlow === "save" ? "Rutyna została zapisana" : "Wczytano zapisaną rutynę",
    heading: "Edytuj swoją bazową rutynę AM/PM",
    intro:
      "Masz już zapisaną bazę. Możesz wracać do niej z nawigacji, zmieniać kolejność kroków, dodawać nowe produkty albo całkowicie wyczyścić stan i zacząć od nowa.",
    panelTitle: "Rutyna jest aktywna",
    panelBody:
      "Poniżej widzisz aktualny stan bazowej rutyny. Zmiany zapisują się jawnie przyciskiem, więc możesz spokojnie edytować draft przed wysłaniem.",
  },
  reset: {
    badge: "Rutyna została wyczyszczona",
    heading: "Masz czystą bazę do ponownego ułożenia",
    intro:
      "Reset usunął tylko zapis rutyny. Produkty na półce nadal są dostępne, więc możesz od razu zbudować nową wersję porannej i wieczornej bazy.",
    panelTitle: "Rutyna jest pusta po resecie",
    panelBody:
      "Półka pozostała bez zmian. Wybierz produkty z katalogu poniżej i ułóż rutynę od początku, bez ponownego dodawania produktów do konta.",
  },
};

const currentStateCopy = pageStateCopy[pageState];
---

<Layout title="Moja rutyna" showAppNavigation>
  <div class="text-white">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-6 py-6 sm:py-10">
      <section class="rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
        <div class="flex flex-col gap-4 border-b border-white/10 pb-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">Manual routine management</p>
            <h1 class="mt-2 text-3xl font-bold text-white">{currentStateCopy.heading}</h1>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-blue-100/75">
              {currentStateCopy.intro}
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <div class="rounded-full border border-white/12 bg-black/15 px-4 py-2 text-sm text-blue-100/80">
              {currentStateCopy.badge}
            </div>
            <a
              href="/products/intake"
              class="rounded-full border border-white/20 bg-white/8 px-4 py-2 text-sm text-white transition-colors hover:bg-white/16"
            >
              Dodaj produkt do półki
            </a>
          </div>
        </div>

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        {
          success && (
            <p class="mt-6 rounded-2xl border border-emerald-400/30 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-200">
              {success}
            </p>
          )
        }

        {
          error && (
            <p class="mt-6 rounded-2xl border border-red-400/30 bg-red-950/40 px-4 py-3 text-sm text-red-200">
              {error}
            </p>
          )
        }

        {
          !routeError && (
            <>
              <div class="mt-6 rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
                <p class="text-sm font-semibold text-white">{currentStateCopy.panelTitle}</p>
                <p class="mt-3 max-w-3xl text-sm leading-6 text-blue-100/70">{currentStateCopy.panelBody}</p>
              </div>

              <div class="mt-6 grid gap-4 md:grid-cols-3">
                <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
                  <p class="text-sm font-semibold text-white">Produkty na półce</p>
                  <p class="mt-3 text-sm leading-6 text-blue-100/70">
                    {shelfCount === 0
                      ? "Nie masz jeszcze żadnych produktów na półce."
                      : `Masz obecnie ${shelfCount} ${shelfCount === 1 ? "produkt" : "produkty"} gotowe do użycia w rutynie.`}
                  </p>
                </div>

                <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
                  <p class="text-sm font-semibold text-white">Zakres tego etapu</p>
                  <p class="mt-3 text-sm leading-6 text-blue-100/70">
                    W tej fazie ustawiasz tylko sekcję `AM/PM`, role produktów i kolejność kroków. Harmonogramy typu
                    weekday albo custom interval wrócą później.
                  </p>
                </div>

                <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
                  <p class="text-sm font-semibold text-white">Semantyka zapisu</p>
                  <p class="mt-3 text-sm leading-6 text-blue-100/70">
                    Ta sama pozycja z półki może wystąpić wielokrotnie. Reset czyści tylko rutynę, nie usuwa produktów z
                    półki.
                  </p>
                </div>
              </div>

              {hasVeryFewProducts && (
                <p class="mt-6 rounded-2xl border border-cyan-300/20 bg-cyan-300/8 px-4 py-3 text-sm text-blue-100/80">
                  Masz na półce tylko jeden produkt. Widok rutyny pozostaje dostępny, ale dla sensownego układu porannej
                  i wieczornej bazy prawdopodobnie będziesz chcieć dodać jeszcze kilka pozycji.
                </p>
              )}

              <div class="mt-8">
                <ManualRoutineEditor client:load initialDraft={initialDraft} shelfCatalog={shelfCatalog} />
              </div>
            </>
          )
        }
      </section>
    </div>
  </div>
</Layout>
