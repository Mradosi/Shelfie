---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import {
  getSkinAspectLevelLabel,
  createEmptyUserProfile,
  getMissingUserDomainContractMessage,
  getUserProfile,
  isMissingUserDomainContractError,
  SKIN_ASPECT_KEYS,
  SKIN_ASPECT_LABELS,
  SKIN_ASPECT_LEVELS,
  SKIN_TYPE_LABELS,
  SKIN_TYPE_OPTIONS,
} from "@/lib/domain/user-domain";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const supabase = createClient(Astro.request.headers, Astro.cookies);
let domainError: string | null = null;
let persistedProfile = null;

if (supabase && user) {
  try {
    persistedProfile = await getUserProfile(supabase, user.id);
  } catch (loadError) {
    if (isMissingUserDomainContractError(loadError)) {
      domainError = getMissingUserDomainContractMessage();
    } else {
      throw loadError;
    }
  }
}

const profile = persistedProfile ?? createEmptyUserProfile();
const concernsValue = profile.concerns.join(", ");
const goalsValue = profile.goals.join(", ");
const formDisabled = Boolean(domainError);
const hasPersistedProfile = Boolean(persistedProfile);
const verificationStateLabel = domainError
  ? "Brakuje migracji"
  : hasPersistedProfile
    ? "Wczytano zapisany profil"
    : "Gotowe do utworzenia pierwszego profilu";
const skinAspectFields = SKIN_ASPECT_KEYS.map((aspectKey) => ({
  key: aspectKey,
  label: SKIN_ASPECT_LABELS[aspectKey],
  value: profile.skinAspects[aspectKey],
}));
---

<Layout title="Panel">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center py-10">
      <div class="grid w-full gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(20rem,0.6fr)]">
        <section class="rounded-[2rem] border border-white/12 bg-white/10 p-8 backdrop-blur-xl">
          <div class="flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-sm tracking-[0.24em] text-blue-100/55 uppercase">Test trwałości danych</p>
              <h1
                class="mt-2 bg-gradient-to-r from-blue-100 via-cyan-100 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
              >
                Kontrakt profilu użytkownika
              </h1>
            </div>
            <div class="rounded-full border border-white/12 bg-black/15 px-4 py-2 text-sm text-blue-100/80">
              Zalogowano jako <span class="font-semibold text-white">{user?.email}</span>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            {
              domainError && (
                <p class="rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
                  {domainError}
                </p>
              )
            }
            {
              success && (
                <p class="rounded-2xl border border-emerald-400/30 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-200">
                  {success}
                </p>
              )
            }
            {
              error && (
                <p class="rounded-2xl border border-red-400/30 bg-red-950/40 px-4 py-3 text-sm text-red-200">{error}</p>
              )
            }
          </div>

          <div class="mt-6 rounded-[1.75rem] border border-cyan-300/15 bg-slate-950/30 p-5">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="text-sm tracking-[0.22em] text-cyan-100/55 uppercase">Powierzchnia weryfikacyjna</p>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-blue-100/75">
                  Ten panel jest celowo technicznym ekranem do weryfikacji, a nie docelowym onboardingiem. Używaj go do
                  sprawdzenia, czy zalogowany użytkownik może zapisać, odświeżyć i zachować swój profil między sesjami.
                </p>
              </div>
              <div class="flex flex-col items-start gap-3 sm:items-end">
                <div class="rounded-full border border-white/12 bg-black/20 px-4 py-2 text-sm text-cyan-100">
                  {verificationStateLabel}
                </div>
                <a
                  href="/settings/skin-profile"
                  class="rounded-full border border-white/20 bg-white/8 px-4 py-2 text-sm text-white transition-colors hover:bg-white/16"
                >
                  Przejdź do edycji profilu
                </a>
              </div>
            </div>
          </div>

          <form method="POST" action="/api/domain/profile" class="mt-6 space-y-6">
            <label class="block">
              <span class="mb-2 block text-sm text-blue-100/80">Typ skóry</span>
              <select
                name="skinType"
                disabled={formDisabled}
                class="w-full rounded-2xl border border-white/12 bg-slate-950/35 px-4 py-3 text-white focus:border-cyan-300/60 focus:outline-none"
              >
                <option value="" selected={profile.skinType === null}>Wybierz bazowy typ skóry</option>
                {
                  SKIN_TYPE_OPTIONS.map((skinType) => (
                    <option value={skinType} selected={profile.skinType === skinType}>
                      {SKIN_TYPE_LABELS[skinType]}
                    </option>
                  ))
                }
              </select>
            </label>

            <div>
              <div class="mb-2 flex items-center justify-between">
                <span class="block text-sm text-blue-100/80">Obszary skóry</span>
                <span class="text-xs text-blue-100/45">Strukturalne poziomy dla pięciu głównych wymiarów</span>
              </div>
              <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {
                  skinAspectFields.map((aspect) => (
                    <label class="block">
                      <span class="mb-2 block text-sm text-blue-100/75">{aspect.label}</span>
                      <select
                        name={`skinAspect_${aspect.key}`}
                        disabled={formDisabled}
                        class="w-full rounded-2xl border border-white/12 bg-slate-950/35 px-4 py-3 text-white focus:border-cyan-300/60 focus:outline-none"
                      >
                        {SKIN_ASPECT_LEVELS.map((level) => (
                          <option value={level} selected={aspect.value === level}>
                            {getSkinAspectLevelLabel(aspect.key, level)}
                          </option>
                        ))}
                      </select>
                    </label>
                  ))
                }
              </div>
            </div>

            <label class="block">
              <span class="mb-2 block text-sm text-blue-100/80">Potrzeby skóry</span>
              <input
                type="text"
                name="concerns"
                value={concernsValue}
                placeholder="np. zaskórniki zamknięte, zaczerwienienie, cienie pod oczami"
                disabled={formDisabled}
                class="w-full rounded-2xl border border-white/12 bg-slate-950/35 px-4 py-3 text-white placeholder:text-blue-100/35 focus:border-cyan-300/60 focus:outline-none"
              />
              <span class="mt-2 block text-xs text-blue-100/45">
                Na razie zostawiamy te wpisy jako swobodne opisy. Kanoniczne tagi pojawią się w późniejszym etapie.
              </span>
            </label>

            <label class="block">
              <span class="mb-2 block text-sm text-blue-100/80">Cele</span>
              <input
                type="text"
                name="goals"
                value={goalsValue}
                placeholder="np. gładsza tekstura, spokojniejsza skóra"
                disabled={formDisabled}
                class="w-full rounded-2xl border border-white/12 bg-slate-950/35 px-4 py-3 text-white placeholder:text-blue-100/35 focus:border-cyan-300/60 focus:outline-none"
              />
              <span class="mt-2 block text-xs text-blue-100/45">
                Cele też pozostają na tym etapie swobodnymi wpisami, żeby nie zamykać słownika zbyt wcześnie.
              </span>
            </label>

            <label class="block">
              <span class="mb-2 block text-sm text-blue-100/80">Notatki</span>
              <textarea
                name="notes"
                rows="4"
                disabled={formDisabled}
                placeholder="Opcjonalny kontekst, który jeszcze nie mieści się w strukturze profilu"
                class="w-full rounded-2xl border border-white/12 bg-slate-950/35 px-4 py-3 text-white placeholder:text-blue-100/35 focus:border-cyan-300/60 focus:outline-none"
                >{profile.notes ?? ""}</textarea
              >
            </label>

            <div
              class="flex flex-col gap-3 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="text-sm text-blue-100/60">
                {
                  persistedProfile ? (
                    <>
                      Zapisany profil zaktualizowano{" "}
                      <span class="font-medium text-white">
                        {new Date(persistedProfile.updatedAt).toLocaleString()}
                      </span>
                      .
                    </>
                  ) : domainError ? (
                    "Ten ekran czeka na zastosowanie migracji domeny."
                  ) : (
                    "Nie ma jeszcze zapisanego profilu. Zapis tego formularza utworzy pierwszy rekord."
                  )
                }
              </div>

              <button
                type="submit"
                disabled={formDisabled}
                class="rounded-full bg-cyan-300 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:bg-slate-400 disabled:text-slate-800 disabled:hover:translate-y-0"
              >
                Zapisz profil
              </button>
            </div>
          </form>
        </section>

        <aside class="flex flex-col gap-4 rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 backdrop-blur-xl">
          <div>
            <p class="text-sm tracking-[0.24em] text-blue-100/45 uppercase">Stan weryfikacji</p>
            <h2 class="mt-2 text-xl font-semibold text-white">Obecny stan</h2>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm">
            <p class="text-blue-100/55">Stan kontraktu</p>
            <p class="mt-2 text-base font-medium text-white">{verificationStateLabel}</p>
            <p class="mt-2 leading-6 text-blue-100/70">
              {
                domainError
                  ? "Uruchom najnowsze migracje Supabase i odśwież tę stronę."
                  : hasPersistedProfile
                    ? "Serwer wczytał zapisany rekord dla aktualnie zalogowanego użytkownika."
                    : "Kontrakt jest gotowy i czeka na pierwszy zapis profilu."
              }
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm">
            <p class="text-blue-100/55">Kontrole ręczne</p>
            <ul class="mt-3 space-y-2 text-blue-100/70">
              <li>1. Zapisz przykładowy profil i odśwież stronę.</li>
              <li>2. Wyloguj się, zaloguj ponownie i potwierdź, że wartości znów się wczytują.</li>
              <li>3. Wejdź na <code>/dashboard</code> bez sesji i potwierdź przekierowanie do logowania.</li>
              <li>4. Otwórz <code>/settings/skin-profile</code> i sprawdź, czy edycja zapisuje zmiany.</li>
            </ul>
          </div>

          <dl class="space-y-4 text-sm">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <dt class="text-blue-100/55">Typ skóry</dt>
              <dd class="mt-1 text-base text-white">
                {profile.skinType ? SKIN_TYPE_LABELS[profile.skinType] : "Brak"}
              </dd>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <dt class="text-blue-100/55">Obszary skóry</dt>
              <dd class="mt-2 space-y-2">
                {
                  skinAspectFields.map((aspect) => (
                    <div class="flex items-center justify-between gap-4 text-sm">
                      <span class="text-blue-100/70">{aspect.label}</span>
                      <span class="font-medium text-white">{getSkinAspectLevelLabel(aspect.key, aspect.value)}</span>
                    </div>
                  ))
                }
              </dd>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <dt class="text-blue-100/55">Potrzeby skóry</dt>
              <dd class="mt-1 text-base text-white">
                {profile.concerns.length > 0 ? profile.concerns.join(", ") : "Brak"}
              </dd>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <dt class="text-blue-100/55">Cele</dt>
              <dd class="mt-1 text-base text-white">
                {profile.goals.length > 0 ? profile.goals.join(", ") : "Brak"}
              </dd>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <dt class="text-blue-100/55">Notatki</dt>
              <dd class="mt-1 text-base text-white">{profile.notes ?? "Brak"}</dd>
            </div>
          </dl>

          <form method="POST" action="/api/auth/signout" class="mt-auto">
            <button
              type="submit"
              class="w-full rounded-full border border-white/20 bg-white/8 px-4 py-2.5 text-sm transition-colors hover:bg-white/16"
            >
              Wyloguj się
            </button>
          </form>
        </aside>
      </div>
    </div>
  </div>
</Layout>
