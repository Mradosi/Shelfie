---
import TodayRoutine from "@/components/routine/TodayRoutine";
import Layout from "@/layouts/Layout.astro";
import {
  createRoutineGuidance,
  createRoutineGuidanceInputs,
  type RoutineGuidance,
} from "@/lib/domain/routine-guidance";
import { listUserProductInterpretations } from "@/lib/domain/product-interpretation";
import { getRoutineDayKeyForDate, getRoutineDaySchedule, ROUTINE_TIME_ZONE } from "@/lib/domain/routine-schedule";
import { createClient } from "@/lib/supabase";
import {
  getMissingUserDomainContractMessage,
  getUserProfile,
  getUserRoutineConfig,
  isMissingUserDomainContractError,
  isUserProfileComplete,
  listUserShelfCatalog,
  type UserShelfCatalogItem,
} from "@/lib/domain/user-domain";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const now = new Date();
const todayDayKey = getRoutineDayKeyForDate(now);
const todayLabel = new Intl.DateTimeFormat("pl-PL", {
  timeZone: ROUTINE_TIME_ZONE,
  weekday: "long",
  day: "numeric",
  month: "long",
}).format(now);
const supabase = createClient(Astro.request.headers, Astro.cookies);
let routeError: string | null = null;
let shelfCatalog: UserShelfCatalogItem[] = [];
let daySchedule = getRoutineDaySchedule({}, todayDayKey);
let todayGuidance: RoutineGuidance | null = null;

if (!supabase) {
  routeError = "Supabase nie jest skonfigurowane.";
} else {
  try {
    const profile = await getUserProfile(supabase, user.id);
    if (!isUserProfileComplete(profile)) {
      return Astro.redirect("/onboarding/skin-profile");
    }

    const [ownedShelfCatalog, routineConfig] = await Promise.all([
      listUserShelfCatalog(supabase, user.id),
      getUserRoutineConfig(supabase, user.id),
    ]);

    shelfCatalog = ownedShelfCatalog;
    daySchedule = getRoutineDaySchedule(routineConfig?.schedule ?? {}, todayDayKey);

    try {
      const interpretations = await listUserProductInterpretations(
        supabase,
        user.id,
        ownedShelfCatalog.map((item) => item.productId),
      );
      todayGuidance = createRoutineGuidance(
        {
          morning: daySchedule.morning.map((entry) => ({
            shelfItemId: entry.shelf_item_id,
            routineRole: entry.routine_role,
          })),
          evening: daySchedule.evening.map((entry) => ({
            shelfItemId: entry.shelf_item_id,
            routineRole: entry.routine_role,
          })),
        },
        createRoutineGuidanceInputs(ownedShelfCatalog, interpretations),
      );
    } catch {
      todayGuidance = null;
    }
  } catch (error) {
    routeError = isMissingUserDomainContractError(error)
      ? getMissingUserDomainContractMessage()
      : error instanceof Error
        ? error.message
        : "Nie udało się wczytać dzisiejszej rutyny.";
  }
}

const hasRoutineEntries = daySchedule.morning.length > 0 || daySchedule.evening.length > 0;
---

<Layout title="Dzisiaj | Shelfie" showAppNavigation>
  <div class="text-white">
    <main class="mx-auto w-full max-w-7xl py-6 sm:py-10">
      <section class="rounded-[2rem] border border-white/12 bg-white/10 p-6 backdrop-blur-xl sm:p-8">
        <div class="flex flex-col gap-5 border-b border-white/10 pb-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-sm tracking-[0.24em] text-cyan-100/55 uppercase">Twój plan na dziś</p>
            <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Rutyna na dziś</h1>
            <p class="mt-3 text-base text-cyan-100/80">{todayLabel}</p>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/70">
              Sprawdź kolejność porannej i wieczornej pielęgnacji. Aby zmienić plan, przejdź do edycji bazowej rutyny.
            </p>
          </div>
          <a
            href="/routine"
            class="inline-flex w-fit rounded-full border border-white/20 bg-white/8 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/16"
          >
            Edytuj bazową rutynę
          </a>
        </div>

        {
          routeError && (
            <p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
              {routeError}
            </p>
          )
        }

        {
          !routeError &&
            (hasRoutineEntries ? (
              <div class="mt-6">
                <TodayRoutine
                  client:load
                  daySchedule={daySchedule}
                  shelfCatalog={shelfCatalog}
                  guidance={todayGuidance}
                />
              </div>
            ) : (
              <section class="mt-6 rounded-[1.75rem] border border-dashed border-cyan-200/25 bg-cyan-200/6 p-6 sm:p-8">
                <p class="text-sm tracking-[0.22em] text-cyan-100/60 uppercase">Brak planu na dziś</p>
                <h2 class="mt-3 text-2xl font-semibold text-white">Najpierw ułóż bazową rutynę</h2>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/75">
                  Gdy zapiszesz poranną albo wieczorną rutynę, zobaczysz tutaj jej kroki w kolejności, którą ustawisz.
                </p>
                <a
                  href="/routine"
                  class="mt-6 inline-flex rounded-full bg-cyan-300 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-transform hover:-translate-y-0.5"
                >
                  Edytuj bazową rutynę
                </a>
              </section>
            ))
        }
      </section>
    </main>
  </div>
</Layout>
